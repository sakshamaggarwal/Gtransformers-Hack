# Vaidya Pulse configuration. Copy to .env (gitignored) and fill in what you have.
#   cp .env.example .env && npm start          -> http://localhost:8888
# Netlify: npx netlify env:import .env   (or Site settings -> Environment variables)
#
# MINIMUM SETUP: only GROQ_API_KEY. Every data source below is keyless.
# With no key at all the app still runs: live sources + ranking work, and a
# rule-based "mock" model writes the answer instead of Llama.

# ---- Answer model ---------------------------------------------------------
# Llama 3.1 8B on Groq. Free key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant          # or llama-3.3-70b-versatile for higher quality

# Optional alternatives (the first one set wins: GROQ > OSS > ANTHROPIC > OPENAI > mock)
# OSS_BASE_URL=http://localhost:11434/v1   # any OpenAI-compatible server, e.g. Ollama: `ollama pull llama3.1:8b`
# OSS_MODEL=llama3.1:8b
# OSS_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_PROVIDER=groq                        # force one: groq | oss | anthropic | openai | mock

# ---- Live data sources (all free, NO keys needed) ---------------------------
# PubMed, ClinicalTrials.gov, OpenFDA, Health Stack Exchange and Reddit (public
# JSON API) are fetched live for every question; the Ayurvedic KB is local.
# LIVE_SOURCES=on                          # off = local knowledge base only (offline demo)
# TOP_K=10                                 # how many ranked items go to the model and the UI

# Optional keys: only raise rate limits
# NCBI_API_KEY=                            # PubMed: 3 -> 10 requests/s   (https://www.ncbi.nlm.nih.gov/account/settings/)
# OPENFDA_API_KEY=                         # OpenFDA: 1k -> 120k requests/day (https://open.fda.gov/apis/authentication/)
# STACKEXCHANGE_KEY=                       # Stack Exchange: 300 -> 10k requests/day (https://stackapps.com/apps/oauth/register)

# Reddit OAuth (optional). Without it, Reddit's public .json API is used.
# Set these if Reddit answers 403 from a cloud host (e.g. on Netlify):
# create a "script" app at https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# ---- Misc -------------------------------------------------------------------------
# INCLUDE_DEMO_COMMUNITY=off               # on = also use the bundled SYNTHETIC demo comments
# RATE_LIMIT_PER_MIN=30
# PORT=8888                                # for `npm start`
