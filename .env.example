# Copy to .env and fill in what you have. .env is gitignored. No key at all = mock mode.
# Live site: npx netlify env:import .env

# ---- Answer model (pick one) ---------------------------------------------
# Default: Llama 3.1 8B on Groq (free key at https://console.groq.com/keys)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant          # or llama-3.3-70b-versatile for higher quality

# Any OpenAI-compatible open-model server (Ollama, Together, Hugging Face, vLLM)
# OSS_BASE_URL=http://localhost:11434/v1   # Ollama: `ollama pull llama3.1:8b`
# OSS_MODEL=llama3.1:8b
# OSS_API_KEY=                             # leave empty for Ollama

# Fallbacks from the starter kit
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# LLM_PROVIDER=groq                        # groq | oss | anthropic | openai | mock

# ---- Live data sources (all free; keys only raise rate limits) -----------
# LIVE_SOURCES=on                          # off = local knowledge base only
# NCBI_API_KEY=                            # PubMed: 3 → 10 req/s
# OPENFDA_API_KEY=                         # OpenFDA: 1k → 120k req/day
# STACKEXCHANGE_KEY=                       # Stack Exchange: 300 → 10k req/day (recommended on Netlify)
# REDDIT_CLIENT_ID=                        # live Reddit search via OAuth "script" app
# REDDIT_CLIENT_SECRET=

# RATE_LIMIT_PER_MIN=30
